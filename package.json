{
  "name": "@dsh-zcode/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official ZCode Agent runtime and native DSH GUI bridge",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "probe": "node scripts/official-probe.mjs"
  },
  "dependencies": {
    "@dsh-zcode/bridge-client": "file:./packages/client",
    "@dsh-zcode/driver": "file:./packages/driver",
    "@dsh-zcode/host": "file:./packages/host",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "docs/protocol-coverage.md",
    "packages/host/package.json",
    "packages/host/*.mjs",
    "packages/host/launcher",
    "packages/host/vendor",
    "packages/driver/package.json",
    "packages/driver/*.mjs",
    "packages/client/package.json",
    "packages/client/index.mjs",
    "packages/client/lib/client.js",
    "packages/client/controller.mjs",
    "packages/client/status.mjs",
    "packages/client/compatibility.mjs"
  ]
}
